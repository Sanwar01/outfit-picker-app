{
  "expo": {
    "name": "Outfit Picker",
    "slug": "outfit-picker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "outfitpicker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.outfitpicker.app"
    },
    "android": {
      "package": "com.outfitpicker.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#f9f8f6"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Outfit Picker to access your photos to add wardrobe items.",
          "cameraPermission": "Allow Outfit Picker to use your camera to photograph clothing."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
