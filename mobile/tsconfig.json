{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/lib/api": ["./lib/api"],
      "@/lib/auth-context": ["./lib/auth-context"],
      "@/lib/billing": ["./lib/billing"],
      "@/lib/brand": ["./lib/brand"],
      "@/lib/create-item-id": ["./lib/create-item-id"],
      "@/lib/has-seen-welcome": ["./lib/has-seen-welcome"],
      "@/lib/location": ["./lib/location"],
      "@/lib/oauth": ["./lib/oauth"],
      "@/lib/outfits": ["./lib/outfits"],
      "@/lib/query-client": ["./lib/query-client"],
      "@/lib/queries/billing": ["./lib/queries/billing"],
      "@/lib/queries/invalidate": ["./lib/queries/invalidate"],
      "@/lib/queries/outfits": ["./lib/queries/outfits"],
      "@/lib/queries/wardrobe": ["./lib/queries/wardrobe"],
      "@/lib/profile-display": ["./lib/profile-display"],
      "@/lib/pro-waitlist": ["./lib/pro-waitlist"],
      "@/lib/remember-email": ["./lib/remember-email"],
      "@/lib/review-queue": ["./lib/review-queue"],
      "@/lib/supabase": ["./lib/supabase"],
      "@/lib/theme": ["./lib/theme"],
      "@/lib/today": ["./lib/today"],
      "@/lib/wardrobe-drafts": ["./lib/wardrobe-drafts"],
      "@/lib/wardrobe-items": ["./lib/wardrobe-items"],
      "@/lib/*": ["../lib/*"],
      "@/*": ["./*"],
      "@shared/*": ["../lib/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
